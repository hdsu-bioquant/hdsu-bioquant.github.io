Host curry
    User bq_user
    HostName curry0.bioquant.uni-heidelberg.de
    ControlMaster auto
    ControlPath ~/.ssh/multiplex/%r@%h:%p
    ControlPersist 10m
    ServerAliveInterval 50
    ServerAliveCountMax 5
    ProxyJump appl2

Host appl2
    User bq_user
    HostName appl2.bioquant.uni-heidelberg.de
    UseKeychain yes

Host curry-small
   HostName curry
   User bq_user
   ProxyCommand ssh %h vscode-curry --mem 16GB --cpus 2
   StrictHostKeyChecking accept-new
   UserKnownHostsFile /dev/null
 
Host curry-medium
   HostName curry
   User bq_user
   ProxyCommand ssh curry vscode-curry --mem 64GB --cpus 12 --time 16:00:00 
   StrictHostKeyChecking accept-new
   UserKnownHostsFile /dev/null
 
Host curry-large
   HostName curry
   User bq_user
